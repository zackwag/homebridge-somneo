    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^3.0.2",
    "ts-node": "^9.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "ts-retry": "^7.0.3"
  }
