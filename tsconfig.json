{
  "compilerOptions": {
    "target": "ES2022", // ~node18+
    "module": "node16",
    "lib": [
      "ES2023",
      "esnext.disposable",
      "dom"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": false
  },
  "include": [
    "src/"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
